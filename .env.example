DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lighthouse
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# Production deploy: APP_BASE_URL=https://getcompset.app

# --- Twilio (local dev defaults to TEST credentials below when both are set) ---
# Toggle in dev: TWILIO_USE_PRODUCTION_CREDENTIALS=true forces live creds locally

# Test (Console → toggle "Test mode" → copy Account SID + Auth Token)
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
# Optional; falls back to live number/service if omitted
TWILIO_TEST_PHONE_NUMBER=
TWILIO_TEST_VERIFY_SERVICE_SID=

# Live / production (Railway, or dev override above)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# System admin (unknown subscribe attempts, inbound unknown)
SYSTEM_ADMIN_PHONE=+1XXXXXXXXXX

# Seed (Emre only in v1)
SEED_ADMIN_PHONE=+1XXXXXXXXXX
SEED_ADMIN_NAME=Emre
SEED_ADMIN_TIMEZONE=America/Los_Angeles

# Optional
SENTRY_DSN=
